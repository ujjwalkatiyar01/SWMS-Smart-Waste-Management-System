# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings -> API (safe in the browser; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=  # Public app origin, for example https://your-app.example

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# SWMS bot uses this same server-only Gemini key for signed-in questions.
# Public homepage help and the fallback work without a key.
# Scripts only (npm run db:push, seed:users). Session pooler connection string; contains the database password.
SUPABASE_DB_URL=
# Password for the sample logins created by npm run seed:users (at least 8 characters).
SEED_USER_PASSWORD=
